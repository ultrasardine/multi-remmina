{
  "enabled": true,
  "name": "Update Documentation on Source Changes",
  "description": "Monitors C source files, headers, CMake files, and plugin code. When changes are detected, prompts the agent to review and update relevant documentation in README.md or other documentation files to keep them in sync with code changes.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "*.c",
      "*.h",
      "CMakeLists.txt",
      "*.cmake",
      "plugins/**/*.c",
      "plugins/**/*.h",
      "src/**/*.c",
      "src/**/*.h"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "A source file has been modified. Please review the changes and determine if any documentation needs to be updated. Check if README.md, CONTRIBUTING.md, or any relevant documentation in the repository should be updated to reflect these code changes. Focus on API changes, new features, configuration options, or architectural changes that users or developers should know about."
  }
}